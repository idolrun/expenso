# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5431/expenso_db"

# Public site URL (no trailing slash). Used for auth client + Better Auth defaults.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Better Auth — minimum 32 characters; use a strong random value in production.
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"

# Optional: explicit Better Auth server base in production (defaults to NEXT_PUBLIC_APP_URL).
# In NODE_ENV=development, Better Auth baseURL always follows NEXT_PUBLIC_APP_URL (see lib/auth.ts)
# so magic links match your dev server (e.g. :3000 even if an old BETTER_AUTH_URL pointed elsewhere).
# BETTER_AUTH_URL="https://app.example.com"

# Optional: comma-separated extra origins for CSRF / redirects (defaults to NEXT_PUBLIC_APP_URL).
# BETTER_AUTH_TRUSTED_ORIGINS="http://localhost:3000,https://app.example.com"

# WebAuthn / passkeys (defaults: rpID=localhost, origin=NEXT_PUBLIC_APP_URL)
# WEBAUTHN_RP_ID="localhost"
# WEBAUTHN_APP_NAME="Expenso"
# WEBAUTHN_ORIGIN="http://localhost:3000"

# ExchangeRate-API (used by the server-side USD/NPR conversion route)
# EXCHANGE_RATE_API_KEY="your-api-key"

# SMTP / Email (Resend via SMTP)
# SMTP_SERVER_HOST=smtp.resend.com
# SMTP_SERVER_PORT=587
# SMTP_SERVER_USERNAME=resend
# SMTP_SERVER_PASSWORD=your_resend_api_key
# MAIL_FROM=noreply@idolrun.com

# For non-prod-style environments only (skip email and log to console):
# MAGIC_LINK_LOG_ONLY="true"

# Vitest: set to 1 to run Prisma-backed integration tests (requires DATABASE_URL and migrations).
# RUN_DB_INTEGRATION=1

# After `pnpm db:seed`, sign-in flows use your auth provider; seed users include:
# admin@seed.expenso.local, user1@seed.expenso.local, user2@seed.expenso.local
