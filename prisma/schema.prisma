
// Prisma 7 breaking change: provider changed from prisma-client-js to prisma-client.
// The older provider will be removed in a future release.
generator client {
  provider      = "prisma-client"
  // Prisma 7 breaking change: output is now REQUIRED.
  // Prisma Client will no longer be generated in node_modules by default.
  output        = "../src/app/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Prisma 7 breaking change: url, directUrl, shadowDatabaseUrl in datasource are DEPRECATED.
// The database URL is configured in prisma.config.ts instead.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  USER
}

enum ExpenseSection {
  OVERVIEW
  TECH
  MARKETING
  SOCIAL_MEDIA
  PETTY_CASH
  SALARY
  TRAVEL
  INVENTORY
  MERCHANDISE
}

enum ExpenseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PAID
  CANCELLED
}

enum AuditAction {
  USER_ROLE_CHANGED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_SOFT_DELETED
  EXPENSE_RESTORED
  ATTACHMENT_ADDED
  ATTACHMENT_REMOVED
  TAG_ASSIGNED
  TAG_REMOVED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_DELETED
  INVENTORY_ITEM_CREATED
  INVENTORY_ITEM_UPDATED
  MERCHANDISE_ITEM_CREATED
  MERCHANDISE_ITEM_UPDATED
  SALARY_RECORD_CREATED
  SALARY_RECORD_UPDATED
  SECTION_BUDGET_CREATED
  SECTION_BUDGET_UPDATED
  OTHER
}

enum CurrencyCode {
  USD
  NPR
}

/// Which cloud storage provider holds the raw file bytes for an attachment.
enum AttachmentProvider {
  /// Cloudinary — delivery/transform via signed API; never expose permanent public URLs.
  CLOUDINARY
  /// Local filesystem or S3-compatible bucket (dev/self-hosted).
  LOCAL
}

/// Controls the window length a section budget covers.
enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
  ANNUAL
}

// ---------------------------------------------------------------------------
// Better Auth (existing) — extended with application role + domain relations
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]

  expensesCreated          Expense[]          @relation("ExpenseCreatedBy")
  expensesUpdated          Expense[]          @relation("ExpenseUpdatedBy")
  expenseHistoryChanges    ExpenseHistory[]   @relation("ExpenseHistoryChangedBy")
  expenseTagsAssigned      ExpenseTag[]       @relation("ExpenseTagAssignedBy")
  attachmentsUploaded      Attachment[]       @relation("AttachmentUploadedBy")
  auditLogs                AuditLog[]         @relation("AuditLogActor")
  inventoryItemsCreated    InventoryItem[]    @relation("InventoryItemCreatedBy")
  inventoryItemsUpdated    InventoryItem[]    @relation("InventoryItemUpdatedBy")
  merchandiseItemsCreated  MerchandiseItem[]  @relation("MerchandiseItemCreatedBy")
  merchandiseItemsUpdated  MerchandiseItem[]  @relation("MerchandiseItemUpdatedBy")
  salaryRecordsCreated     SalaryRecord[]     @relation("SalaryRecordCreatedBy")
  salaryRecordsUpdated     SalaryRecord[]     @relation("SalaryRecordUpdatedBy")
  categoriesCreated        Category[]         @relation("CategoryCreatedBy")
  categoriesUpdated        Category[]         @relation("CategoryUpdatedBy")
  sectionBudgetsCreated    SectionBudget[]    @relation("SectionBudgetCreatedBy")
  sectionBudgetsUpdated    SectionBudget[]    @relation("SectionBudgetUpdatedBy")
  allowedEmailsCreated     AllowedEmail[]     @relation("AllowedEmailCreatedBy")
  allowedEmailsUpdated     AllowedEmail[]     @relation("AllowedEmailUpdatedBy")

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(uuid())
  name         String?
  publicKey    String
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// ---------------------------------------------------------------------------
// Domain: taxonomy
// ---------------------------------------------------------------------------

model Category {
  id          String         @id @default(cuid())
  section     ExpenseSection
  name        String
  slug        String
  description String?
  sortOrder   Int            @default(0)
  isActive    Boolean        @default(true)
  createdById String?        @db.Uuid
  createdBy   User?          @relation("CategoryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?        @db.Uuid
  updatedBy   User?          @relation("CategoryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  expenses Expense[]

  @@unique([section, slug])
  @@index([section, isActive])
  @@index([createdById])
  @@index([updatedById])
  @@map("category")
}

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenseTags ExpenseTag[]

  @@index([name])
  @@map("tag")
}

model ExpenseTag {
  expenseId    String
  tagId        String
  assignedAt   DateTime @default(now())
  assignedById String?  @db.Uuid
  assignedBy   User?    @relation("ExpenseTagAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([expenseId, tagId])
  @@index([tagId])
  @@index([assignedById])
  @@map("expense_tag")
}

// ---------------------------------------------------------------------------
// Domain: expense core
// ---------------------------------------------------------------------------

model Expense {
  id         String         @id @default(cuid())
  section    ExpenseSection
  status     ExpenseStatus  @default(DRAFT)
  title      String
  notes      String?
  incurredOn DateTime       @db.Date

  /// Amount in the currency the expense was originally entered in.
  originalAmount   Decimal      @db.Decimal(19, 4)
  /// The currency the expense was originally entered in (entered by the user).
  originalCurrency CurrencyCode @default(USD)

  /// USD equivalent at time of recording (null until first FX snapshot is captured).
  amountUsd Decimal? @db.Decimal(19, 4)
  /// NPR equivalent at time of recording (null until first FX snapshot is captured).
  amountNpr Decimal? @db.Decimal(19, 4)
  /// 1 USD = fxRateUsdNpr NPR at the moment this expense was saved.
  fxRateUsdNpr     Decimal?  @db.Decimal(14, 6)
  /// When the FX snapshot above was captured (UTC).
  fxRateSnapshotAt DateTime?

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  createdById String  @db.Uuid
  createdBy   User    @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history     ExpenseHistory[]
  expenseTags ExpenseTag[]
  attachments Attachment[]

  inventoryItems   InventoryItem[]
  merchandiseItems MerchandiseItem[]
  salaryRecord     SalaryRecord?

  @@index([section, deletedAt])
  @@index([status, deletedAt])
  @@index([originalCurrency, deletedAt])
  @@index([originalCurrency, incurredOn, deletedAt])
  @@index([categoryId])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([incurredOn])
  @@index([originalAmount])
  @@index([title])
  @@index([deletedAt])
  @@map("expense")
}

/// Field-level change log for expenses (before / after per field).
model ExpenseHistory {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  batchId     String?
  fieldKey    String
  oldValue    Json?
  newValue    Json?
  changedById String   @db.Uuid
  changedBy   User     @relation("ExpenseHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([expenseId, createdAt])
  @@index([changedById])
  @@index([batchId])
  @@index([fieldKey])
  @@map("expense_history")
}

/// Receipt or document attached to an expense, stored privately in a cloud provider.
/// Never store permanent public delivery URLs — generate signed URLs at request time.
model Attachment {
  id       String @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  /// Which storage backend holds the file.
  provider AttachmentProvider @default(LOCAL)

  /// Provider-agnostic opaque key (e.g. S3 object key, or local path).
  /// For Cloudinary, keep this as the public_id for backward compatibility.
  storageKey String

  /// Cloudinary-specific: the stable public_id used for transforms and signed URL generation.
  cloudinaryPublicId String?
  /// Cloudinary asset version — required for deterministic signed URL construction.
  cloudinaryVersion  Int?
  /// Cloudinary folder the asset lives in (e.g. "expenso/receipts/2026").
  cloudinaryFolder   String?
  /// Cloudinary detected format/extension (e.g. "jpg", "pdf", "png").
  cloudinaryFormat   String?

  fileName    String
  contentType String?
  sizeBytes   Int?

  /// Whether access to this file must go through a server-generated signed URL.
  /// Always true for Cloudinary assets in this app; false only for dev/local assets.
  isPrivate Boolean @default(true)

  uploadedById String?  @db.Uuid
  uploadedBy   User?    @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([expenseId])
  @@index([uploadedById])
  @@index([provider, cloudinaryPublicId])
  @@map("attachment")
}

// ---------------------------------------------------------------------------
// Domain: section budgets
// ---------------------------------------------------------------------------

/// A planned spending limit for one section over a fixed calendar window.
/// Each row covers exactly one (section, period, periodStart) combination.
model SectionBudget {
  id      String         @id @default(uuid()) @db.Uuid
  section ExpenseSection
  period  BudgetPeriod

  /// Budget amount in the currency it was entered.
  budgetAmount   Decimal      @db.Decimal(19, 4)
  budgetCurrency CurrencyCode @default(USD)

  /// USD snapshot at time of budget creation (null until FX rate is captured).
  budgetAmountUsd Decimal? @db.Decimal(19, 4)
  /// NPR snapshot at time of budget creation (null until FX rate is captured).
  budgetAmountNpr Decimal? @db.Decimal(19, 4)
  /// 1 USD = fxRateUsdNpr NPR at the moment the budget was saved.
  fxRateUsdNpr     Decimal?  @db.Decimal(14, 6)
  fxRateSnapshotAt DateTime?

  /// Inclusive start of the budget window (UTC date, no time component).
  periodStart DateTime @db.Date
  /// Inclusive end of the budget window (UTC date, no time component).
  periodEnd   DateTime @db.Date

  isActive Boolean @default(true)
  notes    String?

  createdById String?  @db.Uuid
  createdBy   User?    @relation("SectionBudgetCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("SectionBudgetUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One budget per section+period — each period is an independent budget.
  @@unique([section, period])
  @@index([section, isActive, periodStart])
  @@index([periodStart, periodEnd])
  @@index([createdById])
  @@index([updatedById])
  @@map("section_budget")
}

// ---------------------------------------------------------------------------
// Domain: satellite ledgers (normalized; optional link to originating expense)
// ---------------------------------------------------------------------------

model InventoryItem {
  id          String   @id @default(cuid())
  sku         String   @unique
  name        String
  description String?
  quantity    Int      @default(0)
  unit        String?
  unitCost    Decimal? @db.Decimal(19, 4)
  expenseId   String?
  expense     Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  createdById String?  @db.Uuid
  createdBy   User?    @relation("InventoryItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("InventoryItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseId])
  @@index([name])
  @@index([createdById])
  @@index([updatedById])
  @@map("inventory_item")
}

model MerchandiseItem {
  id            String   @id @default(cuid())
  sku           String   @unique
  name          String
  description   String?
  costPrice     Decimal? @db.Decimal(19, 4)
  retailPrice   Decimal? @db.Decimal(19, 4)
  stockQuantity Int      @default(0)
  expenseId     String?
  expense       Expense? @relation(fields: [expenseId], references: [id], onDelete: SetNull)

  createdById String?  @db.Uuid
  createdBy   User?    @relation("MerchandiseItemCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("MerchandiseItemUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expenseId])
  @@index([name])
  @@index([createdById])
  @@index([updatedById])
  @@map("merchandise_item")
}

model SalaryRecord {
  id             String       @id @default(cuid())
  expenseId      String?      @unique
  expense        Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  employeeName   String
  payPeriodStart DateTime     @db.Date
  payPeriodEnd   DateTime     @db.Date
  grossAmount    Decimal      @db.Decimal(19, 4)
  netAmount      Decimal      @db.Decimal(19, 4)
  currency       CurrencyCode @default(USD)
  metadata       Json?

  createdById String?  @db.Uuid
  createdBy   User?    @relation("SalaryRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("SalaryRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([payPeriodStart, payPeriodEnd])
  @@index([employeeName])
  @@index([createdById])
  @@index([updatedById])
  @@map("salary_record")
}

// ---------------------------------------------------------------------------
// Cross-cutting audit (roles, deletes, and other non-field-level events)
// ---------------------------------------------------------------------------

model AllowedEmail {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  note        String?
  isActive    Boolean  @default(true)
  createdById String?  @db.Uuid
  createdBy   User?    @relation("AllowedEmailCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("AllowedEmailUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email, isActive])
  @@index([createdById])
  @@index([updatedById])
  @@map("allowed_email")
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  /// Stable logical type of the affected row, e.g. "User", "Expense".
  entityType String
  /// Primary key as string (UUID/cuid) for polymorphic entity references.
  entityId   String
  actorId    String?     @db.Uuid
  actor      User?       @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}
