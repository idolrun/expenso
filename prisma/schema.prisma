// Prisma 7 breaking change: provider changed from prisma-client-js to prisma-client.
// The older provider will be removed in a future release.
generator client {
  provider      = "prisma-client"
  // Prisma 7 breaking change: output is now REQUIRED.
  // Prisma Client will no longer be generated in node_modules by default.
  output        = "../src/generated/prisma"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

// Prisma 7 breaking change: url, directUrl, shadowDatabaseUrl in datasource are DEPRECATED.
// The database URL is configured in prisma.config.ts instead.
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  USER
}

enum ExpenseSection {
  OVERVIEW
  TECH
  MARKETING
  SOCIAL_MEDIA
  PETTY_CASH
  SALARY
  TRAVEL
  INVENTORY
  MERCHANDISE
}

enum AuditAction {
  USER_ROLE_CHANGED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_ARCHIVED
  EXPENSE_RESTORED
  EXPENSE_SUBMITTED
  EXPENSE_PAID
  EXPENSE_CANCELLED
  ATTACHMENT_ADDED
  ATTACHMENT_ARCHIVED
  TAG_ASSIGNED
  TAG_REMOVED
  TAG_DEACTIVATED
  // CATEGORY_CREATED, CATEGORY_UPDATED, CATEGORY_DELETED — deprecated, no longer emitted
  SALARY_RECORD_CREATED
  SALARY_RECORD_UPDATED
  CREDENTIAL_ENTRY_CREATED
  CREDENTIAL_ENTRY_UPDATED
  CREDENTIAL_ENTRY_DISABLED
  CREDENTIAL_ENTRY_REENABLED
  ALLOWED_EMAIL_CREATED
  ALLOWED_EMAIL_UPDATED
  ALLOWED_EMAIL_DEACTIVATED
  FUNDENTRYCREATED
  FUND_ENTRY_ARCHIVED
  SETTINGS_UPDATED
  OTHER
}

enum CurrencyCode {
  USD
  NPR
}

enum FundSource {
  BANK_TRANSFER
  WALLET
  CASH
  CLIENT_PAYMENT
  LOAN
  INVESTMENT
  GRANT
  OTHER
}

enum PaymentType {
  CASH
  BANK_TRANSFER
  CHEQUE
  MOBILE_WALLET
  CARD
  OTHER
}

enum CredentialAuthMethod {
  EMAIL_PASSWORD
  OAUTH_GOOGLE
  OAUTH_GITHUB
  OAUTH_MICROSOFT
  OAUTH_OTHER
  MAGIC_LINK
  PASSKEY
  TWO_FACTOR_EMAIL_PASSWORD
  TWO_FACTOR_EMAIL_APP
  SSO
  OTHER
}

/// Which cloud storage provider holds the raw file bytes for an attachment.
enum AttachmentProvider {
  /// Cloudinary — delivery/transform via signed API; never expose permanent public URLs.
  CLOUDINARY
  /// Local filesystem or S3-compatible bucket (dev/self-hosted).
  LOCAL
}

// ---------------------------------------------------------------------------
// Better Auth (existing) — extended with application role + domain relations
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(uuid()) @db.Uuid
  email         String    @unique
  name          String?
  emailVerified Boolean   @default(false)
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  passkeys      Passkey[]

  expensesCreated          Expense[]           @relation("ExpenseCreatedBy")
  expensesUpdated          Expense[]           @relation("ExpenseUpdatedBy")
  expenseHistoryChanges    ExpenseHistory[]    @relation("ExpenseHistoryChangedBy")
  expenseTagsAssigned      ExpenseTag[]        @relation("ExpenseTagAssignedBy")
  attachmentsUploaded      Attachment[]        @relation("AttachmentUploadedBy")
  auditLogs                AuditLog[]          @relation("AuditLogActor")
  salaryRecordsCreated     SalaryRecord[]      @relation("SalaryRecordCreatedBy")
  salaryRecordsUpdated     SalaryRecord[]      @relation("SalaryRecordUpdatedBy")
  allowedEmailsCreated     AllowedEmail[]      @relation("AllowedEmailCreatedBy")
  allowedEmailsUpdated     AllowedEmail[]      @relation("AllowedEmailUpdatedBy")
  credentialEntriesCreated CredentialEntry[]   @relation("CredentialEntryCreatedBy")
  credentialEntriesUpdated CredentialEntry[]   @relation("CredentialEntryUpdatedBy")
  credentialHistoryChanges CredentialHistory[] @relation("CredentialHistoryChangedBy")
  fundEntriesCreated       FundEntry[]         @relation("FundEntryCreatedBy")

  @@index([role])
  @@map("user")
}

model Session {
  id        String   @id @default(uuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(uuid())
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Passkey {
  id           String    @id @default(uuid())
  name         String?
  publicKey    String
  userId       String    @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialID String
  counter      Int
  deviceType   String
  backedUp     Boolean
  transports   String?
  createdAt    DateTime?
  aaguid       String?

  @@index([userId])
  @@index([credentialID])
  @@map("passkey")
}

// ---------------------------------------------------------------------------
// Domain: taxonomy
// ---------------------------------------------------------------------------

model Tag {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  color     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenseTags ExpenseTag[]

  @@index([name])
  @@index([isActive])
  @@map("tag")
}

model ExpenseTag {
  expenseId    String
  tagId        String
  assignedAt   DateTime @default(now())
  assignedById String?  @db.Uuid
  assignedBy   User?    @relation("ExpenseTagAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([expenseId, tagId])
  @@index([tagId])
  @@index([assignedById])
  @@map("expense_tag")
}

// ---------------------------------------------------------------------------
// Domain: expense core
// ---------------------------------------------------------------------------

model Expense {
  id       String         @id @default(cuid())
  section  ExpenseSection
  title    String
  notes    String?
  fromDate DateTime       @db.Date
  toDate   DateTime       @db.Date

  /// Amount in the currency the expense was originally entered in.
  originalAmount   Decimal      @db.Decimal(19, 4)
  /// The currency the expense was originally entered in (entered by the user).
  originalCurrency CurrencyCode @default(USD)

  /// USD equivalent at time of recording (null until first FX snapshot is captured).
  amountUsd        Decimal?  @db.Decimal(19, 4)
  /// NPR equivalent at time of recording (null until first FX snapshot is captured).
  amountNpr        Decimal?  @db.Decimal(19, 4)
  /// 1 USD = fxRateUsdNpr NPR at the moment this expense was saved.
  fxRateUsdNpr     Decimal?  @db.Decimal(14, 6)
  /// When the FX snapshot above was captured (UTC).
  fxRateSnapshotAt DateTime?

  paymentType PaymentType @default(OTHER)

  createdById String  @db.Uuid
  createdBy   User    @relation("ExpenseCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  history     ExpenseHistory[]
  expenseTags ExpenseTag[]
  attachments Attachment[]

  salaryRecord     SalaryRecord?

  @@index([section, deletedAt])
  @@index([originalCurrency, deletedAt])
  @@index([originalCurrency, fromDate, toDate, deletedAt])
  @@index([section, deletedAt, originalCurrency])
  @@index([fromDate, toDate, deletedAt])
  @@index([createdById])
  @@index([updatedById])
  @@index([createdAt])
  @@index([originalAmount])
  @@index([amountUsd, deletedAt])
  @@index([amountNpr, deletedAt])
  @@index([title])
  @@index([deletedAt])
  @@index([paymentType])
  @@map("expense")
}

/// Field-level change log for expenses (before / after per field).
model ExpenseHistory {
  id          String   @id @default(cuid())
  expenseId   String
  expense     Expense  @relation(fields: [expenseId], references: [id], onDelete: Restrict)
  batchId     String?
  fieldKey    String
  oldValue    Json?
  newValue    Json?
  changedById String   @db.Uuid
  changedBy   User     @relation("ExpenseHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([expenseId, createdAt])
  @@index([changedById])
  @@index([batchId])
  @@index([fieldKey])
  @@map("expense_history")
}

/// Receipt or document attached to an expense, stored privately in a cloud provider.
/// Never store permanent public delivery URLs — generate signed URLs at request time.
model Attachment {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Restrict)

  /// Which storage backend holds the file.
  provider AttachmentProvider @default(LOCAL)

  /// Provider-agnostic opaque key (e.g. S3 object key, or local path).
  /// For Cloudinary, keep this as the public_id for backward compatibility.
  storageKey String

  /// Cloudinary-specific: the stable public_id used for transforms and signed URL generation.
  cloudinaryPublicId String?
  /// Cloudinary asset version — required for deterministic signed URL construction.
  cloudinaryVersion  Int?
  /// Cloudinary folder the asset lives in (e.g. "expenso/receipts/2026").
  cloudinaryFolder   String?
  /// Cloudinary detected format/extension (e.g. "jpg", "pdf", "png").
  cloudinaryFormat   String?

  fileName    String
  contentType String?
  sizeBytes   Int?

  /// Whether access to this file must go through a server-generated signed URL.
  /// Always true for Cloudinary assets in this app; false only for dev/local assets.
  isPrivate Boolean @default(true)

  uploadedById String?  @db.Uuid
  uploadedBy   User?    @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  deletedAt    DateTime?

  @@index([expenseId])
  @@index([uploadedById])
  @@index([provider, cloudinaryPublicId])
  @@index([deletedAt])
  @@map("attachment")
}

// ---------------------------------------------------------------------------
// Domain: satellite ledgers (normalized; optional link to originating expense)
// ---------------------------------------------------------------------------

model SalaryRecord {
  id             String       @id @default(cuid())
  expenseId      String?      @unique
  expense        Expense?     @relation(fields: [expenseId], references: [id], onDelete: SetNull)
  employeeName   String
  payPeriodStart DateTime     @db.Date
  payPeriodEnd   DateTime     @db.Date
  grossAmount    Decimal      @db.Decimal(19, 4)
  netAmount      Decimal      @db.Decimal(19, 4)
  currency       CurrencyCode @default(USD)
  metadata       Json?

  createdById String? @db.Uuid
  createdBy   User?   @relation("SalaryRecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String? @db.Uuid
  updatedBy   User?   @relation("SalaryRecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([payPeriodStart, payPeriodEnd])
  @@index([employeeName])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedAt])
  @@map("salary_record")
}

model FundEntry {
  id          String       @id @default(cuid())
  amount      Decimal      @db.Decimal(19, 4)
  currency    CurrencyCode @default(USD)
  source      FundSource
  sourceLabel String?
  note        String?
  receivedAt  DateTime     @db.Date

  createdById String @db.Uuid
  createdBy   User   @relation("FundEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  deletedAt DateTime?

  @@index([createdAt])
  @@index([receivedAt])
  @@index([source])
  @@index([currency])
  @@index([createdById])
  @@index([amount])
  @@index([deletedAt])
  @@map("fund_entry")
}

/// Cached exchange rate for resilient FX snapshot computation.
/// Falls back to the most recent cached rate when the live API is unreachable.
model ExchangeRateCache {
  id        String   @id @default(cuid())
  /// Currency pair descriptor, e.g. "USD_NPR".
  pair      String   @unique
  /// The stored rate value (e.g. 133.50).
  rate      Decimal  @db.Decimal(14, 6)
  /// Where this rate came from: "api", "fallback", "manual".
  source    String   @default("api")
  /// When this cache entry was last refreshed.
  cachedAt  DateTime @default(now())
  /// When this cache entry expires (typically 24h).
  expiresAt DateTime

  @@index([pair, expiresAt])
  @@map("exchange_rate_cache")
}

// ---------------------------------------------------------------------------
// Cross-cutting audit (roles, deletes, and other non-field-level events)
// ---------------------------------------------------------------------------

model AllowedEmail {
  id          String   @id @default(uuid()) @db.Uuid
  email       String   @unique
  note        String?
  isActive    Boolean  @default(true)
  createdById String?  @db.Uuid
  createdBy   User?    @relation("AllowedEmailCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById String?  @db.Uuid
  updatedBy   User?    @relation("AllowedEmailUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email, isActive])
  @@index([createdById])
  @@index([updatedById])
  @@map("allowed_email")
}

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  /// Stable logical type of the affected row, e.g. "User", "Expense".
  entityType String
  /// Primary key as string (UUID/cuid) for polymorphic entity references.
  entityId   String
  actorId    String?     @db.Uuid
  actor      User?       @relation("AuditLogActor", fields: [actorId], references: [id], onDelete: SetNull)
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_log")
}

// ---------------------------------------------------------------------------
// Domain: credential vault
// ---------------------------------------------------------------------------

model CredentialEntry {
  id              String               @id @default(cuid())
  appName         String
  appUrl          String?
  loginEmail      String
  password        String?
  authMethod      CredentialAuthMethod
  twoFactorSecret String?
  notes           String?
  isActive        Boolean              @default(true)

  createdById String @db.Uuid
  createdBy   User   @relation("CredentialEntryCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  updatedById String? @db.Uuid
  updatedBy   User?   @relation("CredentialEntryUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  history CredentialHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([authMethod])
  @@index([appName])
  @@index([createdById])
  @@index([updatedById])
  @@map("credential_entry")
}

model CredentialHistory {
  id          String          @id @default(cuid())
  entryId     String
  entry       CredentialEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  fieldKey    String
  oldValue    Json?
  newValue    Json?
  changedById String          @db.Uuid
  changedBy   User            @relation("CredentialHistoryChangedBy", fields: [changedById], references: [id], onDelete: Restrict)
  changedAt   DateTime        @default(now())

  @@index([entryId, changedAt])
  @@index([changedById])
  @@map("credential_history")
}
