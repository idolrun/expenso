# ── Database ──────────────────────────────────────────────────────────────────
# Postgres credentials used by the "db" Docker service.
POSTGRES_USER=expenso
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=expensodb

# Prisma connection string — host MUST be the Docker service name "db".
# Never use "localhost" inside a container.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@expenso-db-1:5432/${POSTGRES_DB}

# ── Next.js ───────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.com

# ── Better Auth ───────────────────────────────────────────────────────────────
# Minimum 32-character random string. Generate with:
#   openssl rand -base64 32
BETTER_AUTH_SECRET=CHANGE_ME_min_32_char_random_string
BETTER_AUTH_URL=https://your-domain.com
BETTER_AUTH_TRUSTED_ORIGINS=https://your-domain.com

# ── WebAuthn / Passkey ────────────────────────────────────────────────────────
WEBAUTHN_RP_ID=your-domain.com
WEBAUTHN_APP_NAME=Expenso
WEBAUTHN_ORIGIN=https://your-domain.com

# ── SMTP / Email (required for magic-link login) ──────────────────────────────
SMTP_SERVER_HOST=smtp.example.com
SMTP_SERVER_PORT=587
SMTP_SERVER_USERNAME=user@example.com
SMTP_SERVER_PASSWORD=CHANGE_ME
MAIL_FROM=noreply@your-domain.com

# ── Cloudinary (attachment storage) ───────────────────────────────────────────
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Exchange Rate API (optional — USD→NPR FX snapshots) ──────────────────────
EXCHANGE_RATE_API_KEY=your-exchangerate-api-key

# ── Docker image tag (used by docker-compose.prod.yml) ────────────────────────
IMAGE_TAG=latest
