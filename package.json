{
  "name": "expenso",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "RUN_DB_INTEGRATION=1 vitest run",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:deploy": "pnpm exec prisma migrate deploy",
    "db:reset": "pnpm exec prisma migrate reset",
    "db:generate": "pnpm exec prisma generate",
    "db:studio": "pnpm exec prisma studio",
    "db:seed": "pnpm exec prisma db seed",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f db",
    "docker:reset": "docker compose down -v && docker compose up -d"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@better-auth/passkey": "^1.6.19",
    "@hookform/resolvers": "^5.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@prisma/client-runtime-utils": "^7.8.0",
    "axios": "^1.18.0",
    "better-auth": "^1.6.19",
    "class-variance-authority": "^0.7.1",
    "cloudinary": "^2.10.0",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "dotenv": "^17.4.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^1.20.0",
    "next": "16.2.9",
    "next-cloudinary": "^6.17.5",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.5",
    "papaparse": "^5.5.3",
    "pg": "^8.21.0",
    "radix-ui": "^1.6.0",
    "react": "19.2.7",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.79.0",
    "react-resizable-panels": "^4.11.2",
    "recharts": "3.8.1",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "swr": "^2.4.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "globals": "^17.6.0",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  },
  "packageManager": "pnpm@10.8.0",
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.2",
      "kysely": "^0.28.17"
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}